{
  "name": "lastmile-aid",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Surplus Food & Emergency-Aid Coordination Platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:shared": "npm --prefix shared run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix backend run test"
  },
  "keywords": [
    "civic-tech",
    "food-waste",
    "emergency-aid",
    "coordination",
    "fefo"
  ],
  "author": "LastMile Aid Team",
  "license": "MIT"
}
